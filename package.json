{
  "name": "dsh-archived-open",
  "version": "0.1.0",
  "description": "点侧栏里的归档会话就自动取消归档并打开，省掉「先取消归档、再点开」两步。",
  "license": "MIT",
  "meta": {
    "title": "归档会话点开即用",
    "description": "点侧栏里的归档会话，自动取消归档并直接打开。"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpboyer2/dsh-archived-open.git"
  },
  "homepage": "https://github.com/gpboyer2/dsh-archived-open#readme",
  "bugs": {
    "url": "https://github.com/gpboyer2/dsh-archived-open/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "archive",
    "unarchive",
    "session",
    "sidebar"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
